# ESP-IDF config for the capture button. PlatformIO builds sdkconfig.button
# from this file; delete sdkconfig.button after changing anything here.

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# Console on the native USB (USB Serial/JTAG on IO12/IO13).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_FREERTOS_HZ=1000

# Brown-out detector. It watches the +3V3 rail (LDO output), not the cell.
# C6 levels: SEL_7=2.51V (IDF default), 6=2.64, 5=2.76, 4=2.92, 3=3.10, 2=3.27.
# Left at the default for the USB-only bench test (no cell fitted, the
# charger output alone feeds the LDO). For field use with a cell, swap to:
#   CONFIG_ESP_BROWNOUT_DET_LVL_SEL_3=y   (3.10 V)
CONFIG_ESP_BROWNOUT_DET=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_7=y



CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# BLE (NimBLE host). Two advertising sets through the
# extended advertising API: legacy 1M (Chrome can only connect through that) and
# connectable Coded PHY (range). Links are moved to Coded after connecting.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_LL_CFG_FEAT_LE_CODED_PHY=y
CONFIG_BT_NIMBLE_EXT_ADV=y
CONFIG_BT_NIMBLE_MAX_EXT_ADV_INSTANCES=2
CONFIG_BT_NIMBLE_EXT_ADV_MAX_SIZE=251
# CONFIG_BT_NIMBLE_ENABLE_PERIODIC_ADV is not set
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# Central + observer: buttons scan for each other on Coded and connect (src/mesh.c).
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# Other buttons plus phones; 2 are kept free for phones (ble.c PHONE_SLOTS).
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=9
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# Light sleep: auto light sleep with tickless idle, BLE controller sleep
# (main XTAL kept as its low-power clock: no 32 kHz crystal on this board).
# On USB the firmware holds a no-light-sleep lock (serial console).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_ESP_PHY_MAC_BB_PD=y
